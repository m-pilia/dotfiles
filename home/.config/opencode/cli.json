{
    "$schema": "https://opencode.ai/v2/cli.json",
    "diffs": {
        "wrap": "word"
    },
    "session": {
        "sidebar": "auto",
        "scrollbar": false,
        "thinking": "hide"
    },
    "animations": true,
    "keybinds": {
        "session.first": "ctrl+g,alt+home",
        "session.last": "ctrl+alt+g",
        "input.line.home": "home",
        "input.line.end": "end",
        "input.buffer.home": "ctrl+home",
        "input.buffer.end": "ctrl+end",
        "messages.copy": "ctrl+shift+c"
    }
}
