[user]
    name = Martino Pilia
    email = martino.pilia@proton.me
    signingkey = 95565E17
[core]
    askpass = /usr/bin/ksshaskpass
    autocrlf = input
    pager = delta
    whitespace = trailing-space,\
                 -space-before-tab,\
                 -indent-with-non-tab,\
                 tab-in-indent,\
                 cr-at-eol
[commit]
    gpgsign = true
[merge]
    conflictstyle=diff3
    tool = meld
[difftool]
    prompt = false
[diff]
    tool = meld
    algorithm = histogram
[interactive]
    diffFilter = delta --color-only
[delta]
    line-numbers = true
    navigate = true  # move between hunks with n and N
[grep]
	patternType = perl
[color]
    ui = auto
[rerere]
    enabled = true
[help]
    autocorrect = 20
[url "https://github.com/"]
    insteadOf = git://github.com/
[submodule]
    recurse = true
[pretty]
    twoliner = format:'%C("#b26818")%h%C(reset) - %C(white)%aD%C(reset) %C(green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n          %C(normal)%s%C(reset) (%C(blue)%an <%ae>%C(reset))'
[alias]
    untracked = ls-files --others --exclude-standard
    ignored = status --ignored
    orphank = !gitk --all --date-order `git reflog | cut -c1-12`&
    adog = log --graph --abbrev-commit --decorate --format=twoliner --all
    ignore = update-index --assume-unchanged
    no-ignore = !git update-index --no-assume-unchanged $(git ls-files $(git rev-parse --show-toplevel))
    log-number = !git log --oneline --color=always --decorate=full HEAD | nl -v 0 | less -R
    dlog = -c diff.external=difft log --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ddiff = -c diff.external=difft diff
[pull]
	ff = only
[init]
    defaultBranch = master
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
